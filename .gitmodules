# 版本锚定见 thirdparty/VERSIONS.md(submodule 钉 commit = 对应 release tag 指向)
# genoffice: ohos-v1.0.1 → ohos/sota-debrand-v0.11.829 / electron: ohos-v37.2.0
[submodule "thirdparty/genoffice"]
	path = thirdparty/genoffice
	url = git@github.com:hackeris/genoffice.git
	branch = ohos/sota-debrand-v0.11.829
[submodule "thirdparty/electron"]
	path = thirdparty/electron
	url = https://gitcode.com/openharmony-sig/electron.git
	branch = electron-v37.2.0-openharmony
[submodule "thirdparty/node-sqlite"]
	path = thirdparty/node-sqlite
	url = https://github.com/photostructure/node-sqlite.git
	branch = main
