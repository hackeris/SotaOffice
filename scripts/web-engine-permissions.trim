    // [GenOffice trim 2026-09-20] 引擎原始 38 条 → 12 条(只保留 Electron 运行时
    // 与 GenOffice 应用所需)。
    // 本片段由 build-ohos.sh 重放进 web_engine/src/main/module.json5
    // (sync-engine.sh 重同步原始版后自动恢复 trim)。
    "requestPermissions": [
      // ===== Electron 运行时 =====
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      },
      // ===== GenOffice 应用集(system_grant)=====
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.RUNNING_LOCK"
      },
      {
        "name": "ohos.permission.PREPARE_APP_TERMINATE"
      },
      {
        "name": "ohos.permission.FILE_ACCESS_PERSIST"
      },
      {
        "name": "ohos.permission.GET_FILE_ICON"
      },
      {
        "name": "ohos.permission.PRINT"
      },
      // ===== ACL 五件(sotaoffice 名下 AGC 申请中;审批落地前 HAP 装不上真机,属预期)=====
      // READ_PASTEBOARD:user_grant,EntryAbility 启动即申请,授予须用户点头
      {
        "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:access_pasteboard",
        "usedScene": { "abilities": ["EntryAbility"], "when": "always" }
      },
      // 三目录:system_grant,装上即授予;shim 第⑦桩探测可写后自动切系统目录
      // (HAR 模块权限必须带 reason,否则 hvigor 00303222)
      {
        "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",
        "reason": "$string:documents_dir",
        "usedScene": { "abilities": ["EntryAbility"], "when": "always" }
      },
      {
        "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",
        "reason": "$string:download_dir",
        "usedScene": { "abilities": ["EntryAbility"], "when": "always" }
      },
      {
        "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",
        "reason": "$string:desktop_dir",
        "usedScene": { "abilities": ["EntryAbility"], "when": "always" }
      }
    ],
